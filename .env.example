# Copiar a .env (o definir en el servidor) y completar.
# PIN para entrar a /admin. Obligatorio.
ADMIN_PIN=cambia-este-pin
# PIN para la página de canje /staff (encargados de los puestos). El ADMIN_PIN también entra.
STAFF_PIN=cambia-este-pin-staff
# Solo servidor propio: carpeta donde se guardan los datos (JSON). En Netlify no se usa.
STORAGE_DIR=./data
# Solo servidor propio: puerto HTTP.
PORT=8080
